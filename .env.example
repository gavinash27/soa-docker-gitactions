# Docker Hub namespace used by Compose image names (publishing uses the GitHub secret).
DOCKERHUB_USERNAME=your-dockerhub-username

# Local development database credentials; replace before any shared deployment.
POSTGRES_DB=dockertask
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-for-local-use

# Host ports (chosen to avoid the classroom project's common 3000/5432 mappings).
FRONTEND_HOST_PORT=3001
BACKEND_HOST_PORT=8082
POSTGRES_HOST_PORT=5433
